# Copy to .env and fill in. Never commit .env. Tests and JAGA_USE_FAKES=true need none of these keys.

# Meta Model API: dev.meta.ai -> API keys -> Create API key (shown once). Card on Billing, $150 credits per person.
# One key covers Muse Spark (muse-spark-1.3, Standard tier; never the -contributor models) and Muse Voice Transcribe
# (muse-voice-transcribe-1.0, realtime at wss://api.meta.ai/v1/asr/realtime). Muse Spark calls send store:false; account-level ZDR needs an enterprise account.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Baseten (Muse Spark Open, open weights; eval ablation and the open-weights bonus). OpenAI-compatible Chat Completions.
# The hackathon key only works with model meta-models/muse-spark-open-1026 (not the docs' muse-spark-open).
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Twilio. A trial account can't run the Jaga line (voice only in the sign-up country, no bought numbers): upgrade first.
# Demo uses a US number; +60 numbers need SSM and MCMC review.
# Account SID and Auth Token: Console home.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Account -> API keys & tokens -> Create API key (Standard). Signs the Voice SDK access tokens for the app.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Voice -> TwiML Apps -> Create; Voice URL = the server's public voice webhook (Fly.io URL, or a tunnel locally).
TWILIO_TWIML_APP_SID=
# Phone Numbers -> Buy a number (US, Voice), E.164 like +15551234567; point its voice webhook at the server.
TWILIO_NUMBER=
# Voice -> Credentials -> Push Credentials -> FCM, using the Firebase service-account JSON. Rings the app on Android.
TWILIO_PUSH_CREDENTIAL_SID=

# Firebase (FCM push, Auth, Firestore). Path to the service-account JSON, kept outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# true = use server/jaga/fakes instead of real Meta and Twilio clients (default until keys exist)
JAGA_USE_FAKES=true

# The server's public https origin as Twilio calls it (no trailing slash), e.g. https://jaga-server.fly.dev. Twilio
# signatures cover the exact URL, so set it when a proxy rewrites the Host header. Unset = the request's Host.
JAGA_PUBLIC_URL=
# Voice SDK identity the app registers as; the Jaga line rings it (<Dial><Client>).
JAGA_APP_CLIENT_IDENTITY=jaga-app

# Region pack a call uses when the Jaga line sets none for the protected user (a file in server/jaga/regions)
JAGA_DEFAULT_REGION=my
