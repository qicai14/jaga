# Copy to .env and fill in. Never commit .env.

# Meta Model API (credits arrive at kickoff). Use Standard mode, never contributor models. Ask for zero data retention.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Twilio (demo uses a US number; +60 numbers need SSM and MCMC review)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_NUMBER=

# Firebase (FCM push, Auth, Firestore). Path to the service-account JSON, kept outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# true = use server/jaga/fakes instead of real Meta and Twilio clients (default until keys exist)
JAGA_USE_FAKES=true
